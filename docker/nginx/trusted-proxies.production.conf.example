# Proxies confiáveis do nginx em produção (Etapa 4, T-02). Copie para um
# arquivo fora do git (ex.: docker/nginx/trusted-proxies.production.conf) e
# aponte NGINX_TRUSTED_PROXIES_FILE para ele no .env do servidor.
# Liste só o IP do proxy reverso/balanceador que fica na frente deste nginx:
# qualquer endereço listado aqui pode forjar o IP do visitante via
# X-Forwarded-For. Nunca use faixas amplas nem 0.0.0.0/0.
# 203.0.113.10 é um IP documental (RFC 5737): troque pelo IP do proxy real.
set_real_ip_from 203.0.113.10;
