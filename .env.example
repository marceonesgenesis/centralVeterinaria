COMPOSE_PROJECT_NAME=centralvet
# Ambientes previstos: development (padrão local/CI, este arquivo),
# staging e production (documentados em docs/runbooks/environments.md;
# nenhum dos dois é implantado nesta fase — sem domínio, TLS ou infra real).
# Em staging/production, além de credenciais fortes exclusivas do ambiente,
# espera-se no mínimo: APP_DEBUG=false, APP_ENV correspondente, STORAGE_DRIVER
# apontando para um S3/R2 real (não MinIO) e METRICS_DRIVER/ERROR_TRACKING_DRIVER
# configurados para um provedor real em vez de "null".
APP_ENV=development
APP_DEBUG=false
APP_SEED=change-this-to-at-least-32-random-characters
APP_TIMEZONE=America/Fortaleza
HTTP_PORT=8081
# URL pública absoluta (http/https) usada no link do e-mail de recuperação de
# senha (CentralVet\Security\PublicUrl). Sem ela o reset não envia e-mail e só
# registra o erro no log. Em staging/production use o domínio real com https.
APP_PUBLIC_URL=http://localhost:8081

# Proxy na frente (Etapa 4). O nginx do compose repassa HTTPS=on ao PHP quando
# o proxy TLS da frente manda X-Forwarded-Proto: https; nesse caso deixe false.
# Só use true quando o PHP fica atrás de um proxy que não passa HTTPS e só esse
# proxy alcança o PHP (senão qualquer cliente forja o header).
TRUST_FORWARDED_PROTO=false
# Arquivo com os set_real_ip_from do nginx (montado em
# /etc/nginx/trusted-proxies.conf). Padrão: faixas de dev. Em produção, copie
# docker/nginx/trusted-proxies.production.conf.example, troque o IP pelo do
# proxy real e aponte para a cópia.
# NGINX_TRUSTED_PROXIES_FILE=./docker/nginx/trusted-proxies.dev.conf

# Build versionado (ver docs/runbooks/build-versioning.md). Sem registry
# configurado agora: as imagens ficam só no daemon Docker local/do runner.
IMAGE_REGISTRY=centralvet
IMAGE_TAG=dev

MYSQL_DATABASE=centralvet
MYSQL_USER=centralvet
MYSQL_PASSWORD=change-this-local-password
MYSQL_ROOT_PASSWORD=change-this-local-root-password

# Usuário dedicado só para aplicar migrations (menor privilégio: SELECT,
# INSERT, UPDATE, DELETE, CREATE, DROP, ALTER, REFERENCES, INDEX em
# `centralvet`.* apenas — sem GRANT OPTION, sem acesso a outros schemas).
# Nunca usar MYSQL_ROOT_PASSWORD nem MYSQL_USER (usuário de runtime da
# aplicação) para rodar migrations. Ver src/app/database/migrations/README.md.
MIGRATION_DB_USER=centralvet_migrator
MIGRATION_DB_PASSWORD=change-this-local-migration-password

# Gerada localmente pelo bootstrap SQL; não é consumida pelo Compose.
CENTRALVET_ADMIN_PASSWORD=generated-only-during-authorized-bootstrap

DB_HOST=mysql
DB_PORT=3306
# Hospedagem MySQL 5.7: true fixa modo SQL estrito por conexão.
DB_STRICT_MODE=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
# Defina apenas se o Redis exigir autenticação (não configurado por padrão neste compose).
REDIS_PASSWORD=

# SESSION_DRIVER=redis move a sessão PHP do disco local (não compartilhado
# entre os containers app/worker) para o Redis. "files" preserva o
# comportamento padrão do Adianti. Ver CentralVet\Session\SessionHandlerFactory.
SESSION_DRIVER=redis
SESSION_PREFIX=centralvet:session:
SESSION_LIFETIME=7200

# Rate limit de tentativas de login (bucket por login+IP, hash SHA-256, TTL em segundos).
# Ver CentralVet\Security\LoginRateLimiter.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_DECAY_SECONDS=900

# Stripe (cobrança da assinatura; CentralVet\Billing\Stripe\StripeConfig).
# Deixe vazio aqui: as chaves reais (secreta e do webhook) e os ids de preço
# de cada plano vão só no .env local ou no ambiente do servidor, nunca no git.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=
# E-mail do operador que recebe o alerta de estorno automático (pedido pago com e-mail já cadastrado). Vazio: só o error_log.
BILLING_OPERATOR_EMAIL=
# Redis é o padrão. "files" exige um único servidor e armazenamento privado
# gravável; ver docs/runbooks/shared-hosting-mysql57.md.
RATE_LIMIT_DRIVER=redis

# Limite de POST /lead.php por IP (landing pública), contado a cada envio.
# Padrão 10 por 3600 s. Ver CentralVet\Landing\LeadSubmissionHandler.
# LEAD_RATE_LIMIT_MAX_ATTEMPTS=10
# LEAD_RATE_LIMIT_DECAY_SECONDS=3600

# Limite de POST /checkout.php por IP (landing pública), contado a cada envio.
# Padrão 10 por 3600 s. Ver src/checkout.php e CentralVet\Billing\CheckoutStartHandler.
# CHECKOUT_RATE_LIMIT_MAX_ATTEMPTS=10
# CHECKOUT_RATE_LIMIT_DECAY_SECONDS=3600

# Filas de trabalho consumidas pelo worker (separadas por vírgula) e atraso
# base do backoff exponencial em segundos. Ver CentralVet\Queue\RedisQueue e
# src/bin/worker.php.
WORKER_QUEUE_NAMES=default
QUEUE_BACKOFF_SECONDS=5

# Comunicação (Fase 7A). Driver de e-mail: "log" (sandbox: registra só
# referência, hash do destinatário e tamanhos, sem enviar) ou "smtp" (envio
# real com as variáveis SMTP_* abaixo). Ver CentralVet\Communication.
# SMTP_ENCRYPTION aceita tls, ssl ou none; sem SMTP_USERNAME a autenticação
# fica desligada. Credenciais reais só no .env, nunca aqui.
COMMUNICATION_EMAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_ADDRESS=no-reply@example.invalid
SMTP_FROM_NAME="Central Vet"
SMTP_TIMEOUT_SECONDS=10
# Agendador de lembretes no worker, em segundos (0 desliga o tick; o comando
# bin/communication-scheduler.php continua disponível). Dias para o lembrete
# de cobrança de um recebível em aberto. Usuário de sistema (id positivo)
# usado pelo worker no TenantContext.
COMMUNICATION_SCHEDULER_INTERVAL_SECONDS=3600
COMMUNICATION_RECEIVABLE_REMINDER_DAYS=7
COMMUNICATION_SYSTEM_USER_ID=1

# Observabilidade: destino do log estruturado JSON e nível mínimo. "null"
# desativa métricas/error tracking; "log" grava como evento JSON no mesmo
# stream. Ver CentralVet\Observability\{Logging,Metrics,ErrorTracking}.
LOG_STREAM=php://stderr
LOG_MIN_LEVEL=debug
METRICS_DRIVER=null
ERROR_TRACKING_DRIVER=null

# Storage S3-compatible (CentralVet\Storage). Padrões apontam para o serviço
# MinIO opcional do docker-compose (profile "minio", desligado por padrão):
# `docker compose --profile minio up -d minio`. Nenhum provedor externo real
# nem credencial real — troque por um S3/R2 de verdade só em produção.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=centralvet-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123

# Documentos (Fase 7B). PDFs gerados pelo worker (fila document.generate) vão
# para um storage privado: "local" (padrão; pasta fora do webroot `src/`,
# volume nomeado app_documents no docker-compose) ou "s3" (usa as variáveis
# S3_* acima). Na hospedagem compartilhada, DOCUMENT_STORAGE_LOCAL_ROOT deve
# apontar para uma pasta acima do public_html (nunca dentro dele) — o driver
# local recusa root dentro do webroot. DOCUMENT_SYSTEM_USER_ID é o usuário
# registrado nas ações do worker; DOCUMENT_SWEEP_INTERVAL_SECONDS é o
# intervalo do varredor que republica pedidos presos em "queued".
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_LOCAL_ROOT=/var/www/html/var/documents
DOCUMENT_SYSTEM_USER_ID=1
DOCUMENT_SWEEP_INTERVAL_SECONDS=600

# IA (Fase 8A). Gateway próprio (CentralVet\Ai) via Anthropic Messages API.
# A chave da API só vive no env (.env local ou variável do servidor): nunca
# aqui, em código, log, auditoria ou relatório; deixe vazio sem IA real.
# AI_PROVIDER aceita anthropic ou stub (stub é recusado com APP_ENV=production;
# AI_STUB_BEHAVIOR aceita ok ou timeout). AI_EFFORT aceita
# low|medium|high|xhigh|max. Limites: AI_MAX_OUTPUT_TOKENS 256..32000,
# AI_TIMEOUT_SECONDS 5..60, AI_CONNECT_TIMEOUT_SECONDS 1..15.
# AI_FALLBACKS aceita default (fallback do servidor ligado) ou off.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-sonnet-5-5
AI_EFFORT=low
AI_MAX_OUTPUT_TOKENS=8000
AI_TIMEOUT_SECONDS=30
AI_CONNECT_TIMEOUT_SECONDS=5
AI_FALLBACKS=default
AI_STUB_BEHAVIOR=ok

# Credenciais do próprio serviço MinIO local (profile "minio"). Placeholders,
# nunca segredos reais; usadas apenas em desenvolvimento local.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Backup (Etapa 4; scripts/backup.sh e bin/hosting-backup.php).
# BACKUP_PASSPHRASE_FILE: caminho de um arquivo FORA do repositório com a frase
# de cifra (gere com `openssl rand -base64 48`, chmod 600). Nunca a frase aqui.
# BACKUP_RETENTION_DAYS: dias que os backups locais ficam antes de apagar.
# Cópia externa (opcional): BACKUP_OFFSITE_DIR (diretório montado, ex.: disco
# ou NFS) e/ou BACKUP_OFFSITE_S3_URI (s3://bucket/prefixo) com
# BACKUP_OFFSITE_S3_ENDPOINT para S3-compatível (vazio = AWS). Credenciais S3
# só no ambiente do servidor.
BACKUP_PASSPHRASE_FILE=
BACKUP_RETENTION_DAYS=14
BACKUP_OFFSITE_DIR=
BACKUP_OFFSITE_S3_URI=
BACKUP_OFFSITE_S3_ENDPOINT=
# BACKUP_DIR=var/backups

# Piloto e oferta (Etapa 5; CentralVet\Pilot\PilotSettings e Billing\OfferScope).
# OFFER_PLANS: planos à venda, ids separados por vírgula (vazio ou só ids
# desconhecidos = os 4). OFFER_PREVIEW_FEATURES: recursos fora do recorte do
# piloto ligados em prévia (communication, hospital, ai_advanced); deixe VAZIO
# em produção. SUPPORT_EMAIL é obrigatório em produção (o preflight reprova
# vazio, inválido ou .invalid); SUPPORT_WHATSAPP só dígitos com DDI (10 a 15);
# SUPPORT_HOURS vazio = "Segunda a sexta, das 8h às 18h".
# DATA_RETENTION_DAYS_AFTER_CANCEL: dias (1 a 3650) que os dados ficam após o
# cancelamento antes da exclusão pelo operador.
OFFER_PLANS=starter,pro,business,enterprise
OFFER_PREVIEW_FEATURES=
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
SUPPORT_HOURS=
DATA_RETENTION_DAYS_AFTER_CANCEL=30
